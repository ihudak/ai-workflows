{
  "description": "dev-workflows plugin hooks \u2014 git and specs context injection for this plugin's own commands",
  "hooks": {
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash \"${CLAUDE_PLUGIN_ROOT}/hooks/preload-context.sh\""
          }
        ]
      }
    ]
  }
}
