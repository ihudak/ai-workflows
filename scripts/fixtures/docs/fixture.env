# The fixture's own edition configuration. `check-docs.sh --selftest` runs the gate against
# pass/ with these values, read with --config after the edition config block -- never the
# repository's own, which name plugins and switches this tree does not have. The layout names
# (CMD_DIR, REF_DIR, CLI, ...) are not here: the fixture is written in this edition's layout and
# takes those from the config block. A case that needs another value reads a second --config.
PLUGIN_RELS="plugins/dev-workflows plugins/fixture-two"
CORE_PLUGIN_REL="plugins/dev-workflows"
LOADER_SKILL="dev-workflows:reference"
COST_PLUGIN_RELS="plugins/dev-workflows"
NS_MAP_REL="plugins/dev-workflows/scripts/command-namespaces.json"
HANDOFF_PLUGIN_RELS="plugins/dev-workflows"
GUARD_PLUGIN_RELS="plugins/dev-workflows plugins/fixture-two plugins/fixture-guarded"
ITC_PLUGIN_REL="plugins/fixture-guarded"
HAS_COST=1
HAS_CHOICE_CAP=1
HAS_AUTO_OTHER=1
VENDOR_NEUTRAL=1
CHECK11_FAMILY="glob"
CHECK11_PROSE=0
EDITION_FORBIDDEN_B64=""
INSTRUCTION_TIERS="CLAUDE.md .claude/rules/*.md docs/maintainers/*.md"
VENDORED_COPIES="plugins/dev-workflows/scripts/shared-tool.py:plugins/fixture-guarded/scripts/shared-tool.py plugins/dev-workflows/scripts/catalog-tool.py:plugins/fixture-guarded/scripts/catalog-tool.py"
